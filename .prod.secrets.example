# Copy to .prod.secrets (gitignored), fill in the real values, then push to the
# deployed Pages projects with:
#   npm run secrets:push:production
#   npm run secrets:push:staging
# Both run `wrangler pages secret bulk .prod.secrets --project-name=<project>`.
#
# Secrets ONLY. The non-secret vars (PUBLIC_URL, ADMIN_BOOTSTRAP_EMAILS,
# EVENTS_EMAIL_FROM, MICROSOFT_TENANT_ID) live in wrangler.toml — pushing them
# here would shadow the config values. See docs/backend-setup.md step 7.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PSU-owned single-tenant app ("microsoft" provider).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Non-PSU multi-tenant app ("microsoft-other" provider). Only needed once step
# 6b is done and you want that provider enabled — delete these two lines
# otherwise so they aren't pushed as empty secrets.
MICROSOFT_OTHER_CLIENT_ID=
MICROSOFT_OTHER_CLIENT_SECRET=

RESEND_API_KEY=
